# LLM provider: "openai" | "anthropic" | "mock" (default, no key needed)
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Neo4j (docker-compose up -d neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Qdrant (docker-compose up -d qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ogpi_products

APP_ENV=development
LOG_LEVEL=INFO

# --- ERP / PIM connectors (optional, src/integrations/) ---
AKENEO_BASE_URL=
AKENEO_CLIENT_ID=
AKENEO_CLIENT_SECRET=
AKENEO_USERNAME=
AKENEO_PASSWORD=

SAP_ODATA_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
